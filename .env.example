NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
# no server judge is configured; JUDGE_PROVIDER stays none and /api/judge stays off
JUDGE_PROVIDER=none
# browser = Java compiles and runs client-side with CheerpJ (src/lib/runtimes/java.ts).
# none = Java exercises show the "not available" notice. judge0 = the remote seam.
NEXT_PUBLIC_JUDGE_PROVIDER=browser
JUDGE_ALL_LANGUAGES=false
INVITES_REQUIRED=true
AGENT_DRY_RUN=false
ADMIN_USER_IDS=
# magic links wait for a custom SMTP sender; the built-in Supabase mailer hit its rate limit
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
